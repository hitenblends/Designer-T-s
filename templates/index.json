    "image_with_text_FE9Q3U": {
      "type": "image-with-text",
      "custom_css": [
        ".image-with-text .media-content img {height: 100%; object-fit: cover; border-radius: 25px 25px 25px 25px;}"
      ],
      "settings": {
        "display_on_card": false,
        "image": "shopify://shop_images/tim5.jpg",
