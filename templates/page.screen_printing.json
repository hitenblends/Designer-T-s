      "type": "feature-text-columns",
      "blocks": {
        "column_rQqNfY": {
          "type": "column",
          "settings": {
            "title": "Reduced Color Count",
            "subheading": "<p>By utilizing fewer colors, simulated process can often reduce the number of screens required, which can lead to cost savings and faster production times.</p>"
          }
        },
        "column_3h3mm4": {
          "type": "column",
          "settings": {
            "title": "Enhanced Color Vibrancy",
            "subheading": "<p>Spot colors often offer greater vibrancy and intensity compared to CMYK inks, resulting in more impactful and eye-catching prints.</p>"
          }
        },
        "column_jWACC3": {
          "type": "column",
          "settings": {
            "title": "Greater Control",
            "subheading": "<p>Simulated process provides greater control over the final color appearance, allowing for more precise color matching and a wider range of color possibilities.</p>"
          }
        }
