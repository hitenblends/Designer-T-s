      "type": "feature-text-columns",
      "blocks": {
        "column_mz9RqX": {
          "type": "column",
          "settings": {
            "title": "Color Separation",
            "subheading": "<p>The journey begins with digital color separation. Your artwork is meticulously broken down into four separate images, each representing one of the CMYK colors.</p>"
          }
        },
        "column_zjkBrK": {
          "type": "column",
          "settings": {
            "title": "Screen Creation",
            "subheading": "<p>For each color, a finely-tuned screen is created. These screens act as stencils, precisely controlling the flow of ink onto the garment.</p>"
          }
        },
        "column_Uzpxcj": {
          "type": "column",
          "settings": {
            "title": "Color Alchemy",
            "subheading": "<p>By meticulously controlling the density and overlap of these four colors, our skilled technicians can achieve an astonishing range of colors and shades, bringing your designs to life with breathtaking realism.</p>"
          }
        }
      },
