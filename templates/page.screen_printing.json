      "settings": {
        "title": "4-Color Process Screen Printing: Achieving Photorealistic Results",
        "heading_size": "heading-standard",
        "rich_text": "<p><strong>Unlocking a World of Color<br/></strong><br/>4-color process screen printing, often referred to as CMYK printing, is a sophisticated technique that allows us to reproduce a stunning array of colors, including complex gradients and photorealistic images. This method utilizes four primary colors – Cyan, Magenta, Yellow, and Black – to create a seemingly endless spectrum of hues.</p>",
        "display_on_card": false,
        "content_width_desktop": "lg:w-2/3",
        "button_link": "",
        "button_label": "Shop Now",
        "color_scheme": "secondary",
        "background_override": "#000000",
        "use_gradient_background": false
      }
