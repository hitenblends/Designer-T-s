{% comment %}theme-check-disable MissingTemplate{% endcomment %}
{%- liquid
  assign image_position = image_position
  case image_size
    when 'third'
      assign text_width_desktop = 'lg:col-span-8'
      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-9 lg:col-end-13 image-content'
      else
        assign image_width_desktop = 'lg:col-span-4 image-content'
      endif
    when 'half'
      assign text_width_desktop = 'lg:col-span-6'
      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-7 lg:col-end-13 image-content'
      else
        assign image_width_desktop = 'lg:col-span-6 image-content'
      endif
    when 'three_fifths'
      assign text_width_desktop = 'lg:col-span-5'
      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-6 lg:col-end-13 image-content'
      else
        assign image_width_desktop = 'lg:col-span-7 image-content'
      endif
    when 'two_thirds'
      assign text_width_desktop = 'lg:col-span-4'
      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-5 lg:col-end-13 image-content'
      else
        assign image_width_desktop = 'lg:col-span-8 image-content'
      endif
  endcase
-%}

{%- render 'shape-defs',
  shape: image_shape,
  shape_id: section_id,
  index: index,
  blob_type: blob_type
-%}

<div class="py-section relative z-10 max-w-site mx-auto position-{{ image_position }}">
  <div class="px-section  {% if display_on_card %}card-container{% endif %}">
    <div class="{% if display_on_card %}card p-5 lg:p-10{% endif %} section-content mx-auto relative z-10 text_alignment">
      <div class="grid grid-cols-1 lg:grid-cols-12 grid-flow-row-dense gap-10 image-with-content">
        <div class="{{ image_width_desktop }}">
          {%- if image != blank -%}
            {%- render 'media-image',
              media: image,
              shape_id: section_id,
              shape: image_shape,
              crop: crop,
              rotate: rotate_image,
              is_card: display_on_card,
              container_id: container_id,
              disable_media_style: disable_media_style
            -%}
          {%- else -%}
           {%- render 'media-image-placeholder', shape_id: section_id, container_id: section_id, shape: image_shape, crop: scrop, is_card: display_on_card, blob_type: blob_type -%}
          {%- endif -%}
        </div>
        <div class="flex items-center {{ text_width_desktop }}"  style="background-image:url('{{ patter_img | image_url: width: 2000 }}')">
          <div class="{{ text_alignment }}">
            {% if title != '' %}
            <h2 class="font-heading  {{ heading_size }} heading-style {{ settings.heading_drop_shadow_style }} {% if section.settings.enable_logo %}enable_logo_heading no-center{% endif %}">
               {% if section.settings.enable_logo %}
                  {% if settings.blends_logo_link and settings.blends_logo %}
                  <a href="{{ settings.blends_logo_link }}" target="_blank">
                  <img src="{{ settings.blends_logo | image_url: width: '300x'}}" alt="{{ settings.blends_logo.alt }}">
                  </a>
                {% endif %}
                {% endif %}
              {{ title }}</h2>
            {% endif %}

            <div class="richtext image-with-text-block rte mt-5 max-w-2xl {% if text_alignment contains 'center' %}mx-auto{% elsif text_alignment contains 'right' %}ml-auto{% endif %}">
              {{ richtext }}
            </div>

            {%- if button_link != blank and button_label != '' -%}
            <div class="mt-5">
              <a href="{{ button_link }}" class="inline-block push-btn">
                <span class="push-btn-surface">{{ button_label }}</span>
              </a>
            {%- endif -%}
              
            {%- if button_link1 != blank and button_label1 != '' -%}
              
              <a href="{{ button_link1 }}" class="inline-block push-btn">
                <span class="push-btn-surface">{{ button_label1 }}</span>
              </a>
            </div>
            {%- endif -%}


            <div class="content_box">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'content' %}
                  <div class="sub_content mt-5">
                    {% if block.settings.title != '' %}
                      <h2 class="font-heading h4 heading-style">{{ block.settings.title }}</h2>
                    {% endif %}
          
                    <div class="rte max-w-2xl">
                      {{ block.settings.richtext }}
                    </div>
          
                    {% if block.settings.button_link != blank and block.settings.button_label != '' %}
                      <div>
                        <a href="{{ block.settings.button_link }}" class="inline-block push-btn">
                          <span class="push-btn-surface">{{ block.settings.button_label }}</span>
                        </a>
                      </div>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>

            
          </div>
        </div>
      </div>
    </div>
    {% if section.settings.display_on_card and settings.card_show_border_on_shadow %}<div class="card-border"></div>{% endif %}
  </div>
</div>


