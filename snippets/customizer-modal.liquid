{% comment %}
  DTF Customizer Modal
  Modal that contains the DTF customizer tool
{% endcomment %}

<div class="sp-dtf-modal" id="sp-dtf-modal" style="display: none;">
  <div class="sp-modal-content">
    <div class="sp-modal-header">
      <h3 id="sp-modal-title">Customize Design</h3>
      <button class="sp-modal-close" id="sp-modal-close" onclick="closeDTFModal()">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="sp-modal-body" id="sp-modal-body">
      <!-- DTF customizer will be loaded here dynamically -->
    </div>
  </div>
</div>
