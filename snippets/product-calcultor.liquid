    let allColors = {};

    function extractColors(img, locationId) {
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d");
      canvas.width = img.width;
      canvas.height = img.height;
      ctx.drawImage(img, 0, 0);

      const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      const colorMap = new Map();
      const step = 4 * 4; // sample every 4th pixel for performance

      for (let i = 0; i < data.length; i += step) {
        const r = data[i], g = data[i + 1], b = data[i + 2];
        const key = `${r},${g},${b}`;
        colorMap.set(key, (colorMap.get(key) || 0) + 1);
      }

      // sort by frequency (main color = first)
      const sorted = [...colorMap.entries()].sort((a, b) => b[1] - a[1]);

      // save ALL colors for this location
      allColors[locationId] = sorted.map(([rgb]) => {
        const [r, g, b] = rgb.split(",").map(Number);
        return "#" + [r, g, b].map(x => x.toString(16).padStart(2, "0")).join("");
      });

      // draw initial set
      renderColorSwatches(locationId);
    }

    function renderColorSwatches(locationId) {
      const container = document.getElementById(`detectedColors_${locationId}`);
      const numColors = parseInt(document.getElementById(`numColors_${locationId}`).value);

      container.innerHTML = "";

      if (!allColors[locationId]) return;

      allColors[locationId].slice(0, numColors).forEach(hex => {
        container.innerHTML += `
          <div class="detect-color" style="display:inline-block;text-align:center;margin:4px;">
            <div style="width:40px;height:40px;background:${hex};border:1px solid #aaa;"></div>
            <small>${hex}</small>
          </div>`;
      });

      // update locationData count
      if (locationData[locationId]) {
        locationData[locationId].colors = numColors;
      }
    }



