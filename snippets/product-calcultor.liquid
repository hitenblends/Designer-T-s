        document.getElementById(`height_${i}`).value = data.height;
        document.getElementById(`colors_${i}`).value = data.colors;
        document.getElementById(`imageData_${i}`).style.display="block";

        document.getElementById(`previewOutput_${i}`).innerHTML = `
          <div class="preview-wrapper">
            <img src="${data.previewSrc}" style="max-width:80px;max-height:80px;border:1px solid #ccc;margin-top:5px;">
            <br>
            <small>${data.colors} colors, ${data.width}x${data.height} in</small>
            <br>
            <button type="button" class="remove-preview" onclick="removePreview(${i})">Remove</button>
          </div>
        `;

        closeColorToolPopup(i);
      }


      function removePreview(i) {
        // Clear preview
        document.getElementById(`previewOutput_${i}`).innerHTML = "";

        // Reset stored data
        locationData[i] = null;

        // Optionally reset inputs
        document.getElementById(`width_${i}`).value = "";
        document.getElementById(`height_${i}`).value = "";
        document.getElementById(`colors_${i}`).value = "1";

        // Hide image data block
        document.getElementById(`imageData_${i}`).style.display = "none";
      }

      function removeBackground(imgSrc, canvasEl, previewEl, i) {
        const img = new Image();
        img.crossOrigin = "Anonymous";
        img.onload = () => {
          const ctx = canvasEl.getContext("2d");
          canvasEl.width = img.width;
          canvasEl.height = img.height;
          ctx.drawImage(img, 0, 0);

          const imageData = ctx.getImageData(0, 0, img.width, img.height);
          const data = imageData.data;

          // Top-left pixel = background color
          const r0 = data[0], g0 = data[1], b0 = data[2];

          for (let p = 0; p < data.length; p += 4) {
            const r = data[p], g = data[p + 1], b = data[p + 2];
            const dist = Math.sqrt((r - r0) ** 2 + (g - g0) ** 2 + (b - b0) ** 2);
            if (dist < 40) {
              data[p + 3] = 0; // transparent pixel
            }
          }

          ctx.putImageData(imageData, 0, 0);

          // Export transparent PNG
          const transparentSrc = canvasEl.toDataURL("image/png");
          previewEl.src = transparentSrc;

          // ✅ Save into locationData for final preview
          if (!locationData[i]) locationData[i] = {};
          locationData[i].previewSrc = transparentSrc;
        };
        img.src = imgSrc;
      }


</script>
     
