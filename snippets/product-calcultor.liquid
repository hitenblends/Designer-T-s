                <div style="width:30px;height:30px;margin:auto;background:${hex};border:1px solid #aaa"></div>
                <small>${hex}</small>`;
              container.appendChild(div);
            });
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
    });


