{% if customer.tags contains 'dftcalculator' %}
{% endif %}
  
<style>
  .upcharges label > span {
  order: 2;
  font-weight: normal;
  font-family: Indivisible;
  font-size: 14px;
  line-height: 22px;
}
.upcharges label > span.radio-charge {
  order: 1;
  display: flex;
  align-items: center;
  margin-top: -5px;
}
.upcharges {
  margin-left: 10px;
}
td.DTFdtfoptiontd {display: flex;align-items: center;gap: 10px;}
tr.DTFdtfoptiontr {
  box-shadow: 1px 1px 8px 2px #29ace2;
}
.dtf_calc{
  display: flex;
  padding: 30px 0;
  gap: 25px;
}
.dtf_calc .left, .dtf_calc .right {
  flex: 1 1 45%;
}
.dtf_calc .form-group {
  margin-bottom: 15px;
}
.dtf_calc input, .dtf_calc select {
  width: 100%;
  padding: 8px;
  font-size: 16px;
  border-radius: 0;
  border: 1px solid #000 !important;
  color: #000;
}
.dtf_calc button {
  padding: 10px 20px;
  font-size: 16px;
  background: #29ace2;
  color: #fff;
  border: none;
  cursor: pointer;
  border-radius: 5px;
}
.dtf_calc .location-group {
  background: #fff;
  padding: 15px;
  margin-top: 10px;
  border: 1px solid #ccc;
}
.dtf_calc .results {
  margin-top: 30px;
  background: #fff;
  padding: 20px;
  border: 1px solid #ccc;
}
.dtf_calc .results table {
  width: 100%;
  border-collapse: collapse;
}
.dtf_calc .results tr td:last-child {
  border-left: 1px solid #ddd;
  padding: 8px;
}
.dtf_calc .results tr td{
  padding: 8px;
  color: #000;
}
.dtf_calc .results tr {
  padding: 8px;
  border: 1px solid #ddd;
}
.dtf_calc h2,.results h2 {
  font-size: 22px;
  margin-bottom: 15px;
  line-height: 1.2;
  color: #000;
  font-family: var(--heading-font-stack);
}
.text {
  color: #000;
}
.height_input,.width_input{
  margin-top: 15px;
}
.dtf_calc td {
  padding: 10px 0;
}
.dtf_calc .form-group label {
  font-weight: 600;
  color: #000;
  font-family: var(--heading-font-stack);
}
.upcharges label {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 5px;
}
.upcharges.inner-charge label {
    font-weight: normal;
}
.upcharges label input {
  order: 2;
}
button.dtfbtn {
  position: relative;
  background: transparent;
  color: #000;
}
 
.dtfbtn::before {
  bottom: -5px;
}
.dtfbtn::after {
  top: -5px;
}
.dtfbtn::before, .dtfbtn::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 30px;
  height: 10px;
  border-radius: 10px;
  transition: all .4s ease-in-out;
  transition-delay: 0s;
}
.dtfbtn:hover a::before {
  transform: skewX(40deg) translateX(200%);
}
.dtfbtn a::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 50%;
  height: 100%;
  background: linear-gradient(to left, rgba(255, 255, 255, .5), transparent);
  transform: skewX(40deg) translateX(0);
  transition: all .5s ease-out;
}
.results a.upload_art {
  border: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(41, 172, 226, .05);
  box-shadow: 0 3px 14px rgba(41, 172, 226, 0.5);
  border-top: 1px solid rgba(41, 172, 226, .1);
  border-bottom: 1px solid rgba(41, 172, 226, .1);
  z-index: 1;
  font-weight: 400;
  text-decoration: none;
  transition: all .3s ease-in-out;
  backdrop-filter: blur(15px);
  padding: 5px 0;
  overflow: hidden;
  position: relative;
  flex-wrap: wrap;
}
.dtfbtn:hover::after {
  top: 30px;
   background: #2bd2ff;
  box-shadow: 0 0 5px #2bd2ff, 0 0 15px #2bd2ff, 0 0 30px #2bd2ff, 0 0 60px #2bd2ff;
}
.dtfbtn:hover::before {
  bottom: 30px;
   background: #2bd2ff;
  box-shadow: 0 0 5px #2bd2ff, 0 0 15px #2bd2ff, 0 0 30px #2bd2ff, 0 0 60px #2bd2ff;
}
.dtfbtn:hover::before, .dtfbtn:hover::after {
  height: 50%;
  width: 80%;
  border-radius: 30px;
  transition-delay: .3s;
}
.upcharges.inner-charge label {
  margin: 7px 0;
}
.dtf_calc_outer span {
  color: #000;
}
.dtf_calc_outer label {
  color: #000;
}
.results a.upload_art span {
  text-align: center;
  margin-top: 0;
  width: 100%;
}
.setup_checkbox label {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
}
.setup_checkbox {
  margin-top: 10px;
}
</style>
<div class="dtf_calc_outer">
<div class="section section-blends section-full">
  <div class="dtf_calc">
  
  <div class="left">
     {% if section.settings.heading != blank %}
          <h2 class="heading h2">{{ section.settings.heading }}</h2>
        {% endif %}
     {% if section.settings.text != blank %}
          <div class="text">{{ section.settings.text }}</div>
        {% endif %}
 <br>
     {% if section.settings.image != blank %}
        <div class="image_block">
          <img src="{{ section.settings.image | img_url: 'master' }}">
        </div>
      {% endif %}
  </div>
  <div class="right">
    <h2>DTF Vs Screen Printing Calculator</h2>
    <div class="form-group">
      <label>Quantity</label>
      <input id="quantity" placeholder="Quantity" type="number" /></div>
    <div class="form-group">
      <label>Number of Locations</label>
      <input id="locations" placeholder="Number of Locations" type="number" oninput="generateLocations()" />
    </div>
    <div class="form-group">
      <label>Price of Blank ($)</label>
      <input id="blankPrice" placeholder="Price of Blank ($)" type="text" /></div>
    <div class="form-group">
      <label>Markup Percentage (%)</label>
      <input id="markup" placeholder="Markup Percentage (%)" type="text" /></div>
    <div class="form-group">
      <label>Tax Rate (%)</label>
      <input id="taxRate" placeholder="Tax Rate (%)" type="text" /></div>

      <div class="form-group">
        <label>Application Charge ($ per piece)</label>
        <input id="applicationCharge"   placeholder="Application Charge ($)" type="text" />
      </div>
    
    <div class="form-group" style="display:none">
      <label>Shipping Fee ($)</label>
      <input id="shippingFee" placeholder="Shipping Fee ($)" type="number" /></div>
    <div class="form-group" style="display:none">
      <label>Heat Pressing Fee ($)</label>
      <input id="heatFee" placeholder="Heat Pressing Fee ($)" type="number" /></div>
    <div class="form-group">
        
    <div class="form-group">
      <label>Finishing Charges (Per Unit):</label>
      <div class="upcharges inner-charge">
        <label><span>Poly Bag ($0.35)</span><span class="radio-charge"><input type="checkbox" id="polybag_charge" /></span></label>
        <label><span>Size Sticker ($0.15)</span><span class="radio-charge"><input type="checkbox" id="size_sticker_charge" /></span></label>
        <label><span>Hang Tag ($0.35)</span><span class="radio-charge"><input type="checkbox" id="hangtag_charge" /></span></label>
      </div>
    </div>
      </div>
    <div class="form-group">
      <label>Editable Charges:</label>
      <div class="upcharges inner-charge">
        <label><span>Fleece/Hoodie</span><span class="radio-charge"><input type="checkbox" id="fleece_once" /></span> </label>
        <label><span> 100% Polyester</span><span class="radio-charge"><input type="checkbox" id="polyester_once" /></span></label>
      </div>
    </div>
    <div id="locationContainer" style="display: none;"></div>

    <div style="margin-top: 20px;"><button onclick="calculateTotal()">Calculate</button></div>

    <div id="results" class="results" style="display:none;"></div>
    
  </div>
</div>
</div>
<div class="section section-blends section-full">

</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
const decimalInputs = ['markup', 'blankPrice', 'taxRate'];

  decimalInputs.forEach(function (id) {
    const input = document.getElementById(id);
    if (input) {
      input.addEventListener('blur', function () {
        let cleanedValue = input.value.replace(/\$/g, '');
        const val = parseFloat(cleanedValue);
        if (!isNaN(val)) {
          if (id === 'markup') {
            input.value =  val.toFixed(2) +' %';
           } else if (id === 'taxRate') {
            input.value =  val.toFixed(2) +' %';
           } else if (id === 'blankPrice') {
            input.value = '$' + val.toFixed(2);
          } else {
            input.value = val.toFixed(2);
          }
        }
      });
    }
  });
});
const fleeceCharge = 0.25;
const polyesterCharge = 0.25;
const polybagCharge = 0.55;
  
const dtfTable = [
  [0.25,0.25,0.25,0.25,0.25,0.25,0.25,0.28,0.32,0.35,0.39,0.42,0.46,0.49,0.53],
  [0.25,0.25,0.28,0.35,0.42,0.49,0.56,0.63,0.70,0.77,0.84,0.91,0.98,1.05,1.05],
  [0.25,0.30,0.32,0.42,0.53,0.63,0.74,0.84,0.95,1.05,1.16,1.26,1.37,1.47,1.58],
  [0.25,0.30,0.42,0.56,0.70,0.84,0.98,1.12,1.26,1.40,1.54,1.68,1.82,1.96,2.10],
  [0.25,0.35,0.53,0.70,0.88,1.05,1.23,1.40,1.58,1.75,1.93,2.10,2.28,2.45,2.63],
  [0.25,0.42,0.63,0.84,1.05,1.26,1.47,1.68,1.89,2.10,2.31,2.52,2.73,2.94,3.15],
  [0.25,0.49,0.74,0.98,1.23,1.47,1.72,1.96,2.21,2.45,2.70,2.94,3.19,3.43,3.68],
  [0.28,0.56,0.84,1.12,1.40,1.68,1.96,2.24,2.52,2.80,3.08,3.36,3.64,3.92,4.20],
  [0.32,0.63,0.95,1.26,1.58,1.89,2.21,2.52,2.84,3.15,3.47,3.78,4.10,4.41,4.73],
  [0.35,0.70,1.05,1.40,1.75,2.10,2.45,2.80,3.15,3.50,3.85,4.20,4.55,4.90,5.25],
  [0.39,0.77,1.16,1.54,1.93,2.31,2.70,3.08,3.47,3.85,4.24,4.62,5.01,5.39,5.78],
  [0.42,0.84,1.26,1.68,2.10,2.52,2.94,3.36,3.78,4.20,4.62,5.04,5.46,5.88,6.30],
  [0.46,0.91,1.37,1.82,2.28,2.73,3.19,3.64,4.10,4.55,5.01,5.46,5.92,6.37,6.83],
  [0.49,0.98,1.47,1.96,2.45,2.94,3.43,3.92,4.41,4.90,5.39,5.88,6.37,6.86,7.35],
  [0.53,1.05,1.58,2.10,2.63,3.15,3.68,4.20,4.73,5.25,5.78,6.30,6.83,7.35,7.88]
];

const screenPrintTable = [
  [3.03, 3.88, 5.20, 6.49, 7.69, 8.89, 10.09, 11.29],
  [2.86, 3.66, 4.69, 5.89, 7.09, 8.29, 9.49, 10.69],
  [2.16, 2.79, 3.16, 3.46, 3.76, 4.06, 4.36, 4.66],
  [1.60, 1.95, 2.12, 2.22, 2.32, 2.42, 2.52, 2.62],
  [1.36, 1.66, 1.82, 1.92, 2.02, 2.12, 2.22, 2.32],
  [1.18, 1.51, 1.67, 1.77, 1.87, 1.97, 2.07, 2.17],
  [1.05, 1.26, 1.37, 1.47, 1.57, 1.67, 1.77, 1.87],
  [0.83, 1.10, 1.24, 1.29, 1.34, 1.39, 1.44, 1.49],
  [0.77, 0.94, 1.04, 1.09, 1.17, 1.24, 1.29, 1.34],
  [0.67, 0.77, 0.84, 0.89, 0.97, 1.04, 1.09, 1.14]
];

const qtyRanges = [
  [12, 23], [24, 48], [49, 96], [97, 144], [145, 432], [433, 720],
  [721, 1200], [1201, 3000], [3001, 6000], [6001, Infinity]
];

function getDTFPrice(width, height) {
  const w = Math.min(Math.max(Math.floor(width), 1), 15);
  const h = Math.min(Math.max(Math.floor(height), 1), 15);
  return dtfTable[h - 1][w - 1];
}

function getScreenPrintPrice(qty, colors) {
  let row = 0;
  for (let i = 0; i < qtyRanges.length; i++) {
    if (qty >= qtyRanges[i][0] && qty <= qtyRanges[i][1]) {
      row = i;
      break;
    }
  }
  const col = Math.max(0, Math.min(colors - 1, 7));
  return screenPrintTable[row][col];
}

function generateLocations() {
  const count = parseInt(document.getElementById('locations').value);
  const container = document.getElementById('locationContainer');
  container.innerHTML = '';
  if (isNaN(count) || count < 1) {
    container.style.display = 'none';
    return;
  }
  container.style.display = 'block';
  for (let i = 1; i <= count; i++) {
    const group = document.createElement('div');
    group.className = 'location-group';
    group.innerHTML = `
      <h3>Location ${i}</h3>
      <label>Colors:</label>
      <select id="colors_${i}">
        ${[...Array(8)].map((_, c) => `<option value="${c + 1}">${c + 1} Color</option>`).join('')}
      </select>
      <div class="width_input">
        <label>Width (inches):</label>
        <input type="number" id="width_${i}" placeholder="Width (inches)" />
      </div>
      <div class="height_input">
        <label>Height (inches):</label>
        <input type="number" id="height_${i}" placeholder="Height (inches)" />
      </div>
   <div class="setup_checkbox">
    <label>
    
    <span>
      Setup Charge (New Order - $25)
    </span>
    <span class="radio-charge">
      <input type="checkbox" id="setup_charge_${i}" />
    </span>
    </label>
  </div>
    `;
    container.appendChild(group);
  }
}
function calculateTotal() {
  const qty = parseFloat(document.getElementById('quantity').value);
  const numLocations = parseInt(document.getElementById('locations').value);
  const blank = parseFloat(document.getElementById('blankPrice').value.replace(/\$/g, ''));
  const markup = parseFloat(document.getElementById('markup').value.replace(/\%/g, ''));
  const tax = parseFloat(document.getElementById('taxRate').value.replace(/\%/g, ''));
  const shipping = parseFloat(document.getElementById('shippingFee').value);
  const applicationCharge = parseFloat(document.getElementById('applicationCharge').value || 0);

  const blankWithMarkup = blank + (blank * markup / 100);
  let dtfTotal = 0;
  let screenPrintingTotal = 0;
  let locationDetails = '';
  let upchargeTotal = 0;
  let setupChargeTotal = 0;
  let dtfWithApplication = 0;
  let applicationChargeTotal = 0;


  for (let i = 1; i <= numLocations; i++) {
    const width = parseFloat(document.getElementById(`width_${i}`).value);
    const height = parseFloat(document.getElementById(`height_${i}`).value);
    const colors = parseInt(document.getElementById(`colors_${i}`).value);

    if (width > 15 || height > 15) {
      alert(`Max size for DTF is 15x15 inches. Please correct Location ${i}.`);
      return;
    }

    const dtfUnitPrice = getDTFPrice(width, height);
    const dtfLocationCost = dtfUnitPrice * qty;

    const screenPrintUnitPrice = getScreenPrintPrice(qty, colors);
    const screenPrintCost = screenPrintUnitPrice * qty;
    applicationChargeTotal = applicationCharge * qty;
     dtfWithApplication = dtfTotal + applicationChargeTotal;

    dtfTotal += dtfLocationCost;
    screenPrintingTotal += screenPrintCost;

    if (document.getElementById(`setup_charge_${i}`).checked) {
        setupChargeTotal += 25;
    }

    // Upcharges
    if (document.getElementById('fleece_once').checked) upchargeTotal += fleeceCharge * qty;
    if (document.getElementById('polyester_once').checked) upchargeTotal += polyesterCharge * qty;
    
    if (document.getElementById('polybag_charge').checked) upchargeTotal += 0.35 * qty;
    if (document.getElementById('size_sticker_charge').checked) upchargeTotal += 0.15 * qty;
    if (document.getElementById('hangtag_charge').checked) upchargeTotal += 0.35 * qty;
    
        
    locationDetails += `<tr><td>Location ${i}:</td><td>DTF - $${dtfUnitPrice.toFixed(2)} | Screen Print - $${screenPrintUnitPrice.toFixed(2)} per piece</td></tr>`;
  }

  const printCost = dtfWithApplication < screenPrintingTotal ? dtfWithApplication : screenPrintingTotal;
  const besttext = dtfTotal < screenPrintingTotal ? "DTF" : '';
    const uploaddtf = dtfTotal < screenPrintingTotal ? "<button class='dtfbtn'><a target='_blank' class='upload_art' href='https://www.blendsdtf.com/pages/order-by-size-and-quantity'><img src='https://www.blendsdtf.com/cdn/shop/files/blends_logo_1.png?v=1746523961&width=100'><span>Upload Your ART</span></a></button> " : "<button class='dtfbtn'><a target='_blank' class='upload_art' href='/pages/get-a-quote'><img src='https://designerts.com/cdn/shop/files/Designer_T_s-2_no_border-02.png?v=1747840233&width=200'><span>Upload Your ART</span></a></button>";
  const blankTotal = blankWithMarkup * qty;
  const subtotal = blankTotal + printCost + upchargeTotal + setupChargeTotal + applicationChargeTotal;
  const totalTax = subtotal * (tax / 100);
  const totalPrice = subtotal + totalTax;
  const pricePerPiece = totalPrice / qty;

  document.getElementById('results').innerHTML = `
    <h2>Results</h2>
    <table>
      <tr><td>Quantity:</td><td>${qty}</td></tr>
      <tr><td>Blank Price with Markup:</td><td>$${blankWithMarkup.toFixed(2)} per piece</td></tr>
      ${locationDetails}
      <tr><td>DTF Total Cost:</td><td>$${dtfTotal.toFixed(2)}</td></tr>
      <tr><td>+ Application Charges:</td><td>$${applicationChargeTotal.toFixed(2)}</td></tr>
      <tr><td>DTF Final Cost (with Application):</td><td>$${dtfWithApplication.toFixed(2)}</td></tr>
      <tr><td>Screen Printing Total Cost:</td><td>$${screenPrintingTotal.toFixed(2)}</td></tr>
      <tr><td>Upcharge Total:</td><td>$${upchargeTotal.toFixed(2)}</td></tr>
      <tr><td>Setup Charges:</td><td>$${setupChargeTotal.toFixed(2)}</td></tr>
      <tr class='${besttext}dtfoptiontr'><td>Subtotal (${besttext} Best Option + Upcharges):</td>
      <td class='${besttext}dtfoptiontd'>$${subtotal.toFixed(2)} ${uploaddtf}</td>
      </tr>
      <tr><td>Tax (${tax}%):</td><td>$${totalTax.toFixed(2)}</td></tr>
      <tr style="display:none"><td>Shipping Fee:</td><td>$${shipping.toFixed(2)}</td></tr>
      <tr><td>Total Price (Best Option):</td><td>$${totalPrice.toFixed(2)}</td></tr>
      <tr><td>Price Per Piece:</td><td>$${pricePerPiece.toFixed(2)}</td></tr>
    </table>
  `;
  document.getElementById('results').style.display = 'block';
}

</script>
