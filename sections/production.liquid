<link rel="stylesheet" href="{{ 'production.css' | asset_url }}" type="text/css">


{% if section.blocks.size > 0 %}
  {% style %}
    #production--{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
    }
  {% endstyle %}
  <div id="production--{{ section.id }}" class="production-section py-section-vertical-spacing">
    <div class="page-width max-w-site mx-auto px-section">
      {% if section.settings.heading != blank or section.settings.text != blank %}
        <div class="section-header-wrapper">
          {% if section.settings.heading != blank %}
            <h2 class="font-heading text-center heading-standard heading-style full_shadow mb-5">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.text != blank %}
            <p class="text text-center">{{ section.settings.text }}</p>
          {% endif %}
        </div>
      {% endif %}
      <div class="flex-product-content section-content-top-margin">
        <div class="left-content">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'left_icon' %}
              {% if block.settings.image != blank or block.settings.heading != blank or block.settings.text != blank %}
                <div class="icon-text-content">
                  {% if block.settings.image != blank %}
                    <div class="image-wrapper">
                      <img src="{{ block.settings.image | image_url: width: 40, height: 40 }}" alt="{{ block.settings.image.alt }}">
                    </div>
                  {% endif %}
                  {% if block.settings.heading != blank or block.settings.text != blank %}
                    <div class="text-wrapper">
                      {% if block.settings.heading != blank %}
                        <h3 class="heading font-heading heading-secondary break-words">{{ block.settings.heading }}</h3>
                      {% endif %}
                      {% if block.settings.text != blank %}
                        <p class="text">{{ block.settings.text }}</p>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
  
        {% if section.settings.image != blank %}
          <div class="middle-content">
            <img src="{{ section.settings.image | image_url: width: 600 }}" alt="{{ section.settings.image.alt }}">
          </div>
        {% endif %}
        
        <div class="right-content">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'right_icon' %}
              {% if block.settings.image != blank or block.settings.heading != blank or block.settings.text != blank %}
                <div class="icon-text-content">
                  {% if block.settings.image != blank %}
                    <div class="image-wrapper">
                      <img src="{{ block.settings.image | image_url: width: 40, height: 40 }}" alt="{{ block.settings.image.alt }}">
                    </div>
                  {% endif %}
                  {% if block.settings.heading != blank or block.settings.text != blank %}
                    <div class="text-wrapper">
                      {% if block.settings.heading != blank %}
                        <h3 class="heading font-heading heading-secondary break-words">{{ block.settings.heading }}</h3>
                      {% endif %}
                      {% if block.settings.text != blank %}
                        <p class="text">{{ block.settings.text }}</p>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
  {
    "name": "Production Section",
    "settings": [
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#000000"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "inline_richtext",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      }
    ],
    "blocks": [
      {
        "type": "left_icon",
        "name": "Left Icon",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Text"
          }
        ]
      },
      {
        "type": "right_icon",
        "name": "Right Icon",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "inline_richtext",
            "id": "text",
            "label": "Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Production Section"
      }
    ]
  }
{% endschema %}