{% if section.settings.embended_map != blank or section.settings.text != blank or section.settings.title != blank or section.settings.button != blank or section.settings.time != blank %}

  {% style %}
    #our-map-store--{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
    }
  {% endstyle %}
  
  <div id="our-map-store--{{ section.id }}" class="our-map-store py-section-vertical-spacing">
    <div class="px-section relative z-10 max-w-site mx-auto">
      {% if section.settings.heading != blank %}
        <h2 class="heading font-heading  heading-standard heading-style break-words full_shadow text-center">{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="map-with-information section-content-top-margin">
        {% if section.settings.embended_map != blank %}
          <div class="map-wrapper">
            {{ section.settings.embended_map }}
          </div>
        {% endif %}
        {% if section.settings.text != blank or section.settings.title != blank or section.settings.button != blank or section.settings.time != blank %}
          <div class="map-information ">
            <div class="multiple-information">
              {% if section.settings.text != blank or section.settings.title != blank %}
                <div class="left-address">
                  {% if section.settings.title != blank %}
                    <h2 class="heading font-heading heading-secondary break-words mb-2">{{ section.settings.title }}</h2>
                  {% endif %}
                  {% if section.settings.text != blank %}
                    <p class="text">{{ section.settings.text }}</p>
                  {% endif %}
                </div>
              {% endif %}
    
              {% if section.settings.time != blank %}
                <div class="address-timing">
                  {{ section.settings.time }}
                </div>
              {% endif %}
    
              {% if section.settings.button != blank and section.settings.link != blank %}
                <div class="button-wrapper">
                  <a href="{{ section.settings.link }}" class="inline-block push-btn quote_btn">
                    <span class="push-btn-surface">{{ section.settings.button }}</span>
                  </a>
                </div>
              {% endif %}
              
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
  {
    "name": "Our map store",
    "settings": [
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#000000"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "html",
        "id": "embended_map",
        "label": "Map Iframe"
      },
      {
        "type": "header",
        "content": "Information"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "inline_richtext",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "richtext",
        "id": "time",
        "label": "Time"
      },
      {
        "type": "text",
        "id": "button",
        "label": "Button"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      }
    ],
    "presets": [
      {
        "name": "Our map store"
      }
    ]
  }
{% endschema %}