{% if section.settings.heading != blank or section.settings.text != blank or section.settings.button != blank %}

  {% style %}
    #our-expert--{{ section.id }}{
      background-color: {{ section.settings.bg_color }};
    }
  {% endstyle %}
  
  <div id="our-expert--{{ section.id }}" class="our-expert-section">
    <div class="page-width max-w-site mx-auto px-section">
      <div class="container-text-content">
        {% if section.settings.heading != blank %}
          <h2 class="heading font-heading  heading-standard heading-style break-words full_shadow mb-6">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <p class="text mb-6">{{ section.settings.text }}</p>
        {% endif %}
        {% if section.settings.button != blank or section.settings.link != blank %}
          <a href="{{ section.settings.link }}" target="_blank" class="inline-block push-btn quote_btn"><span class="push-btn-surface">{{ section.settings.button }}</span></a>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
  {
    "name": "Our Expert",
    "settings": [
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#000000"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "inline_richtext",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "text",
        "id": "button",
        "label": "Button"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      }
    ],
    "presets":[
      {
        "name": "Our Expert"
      }
    ]
  }
{% endschema %}