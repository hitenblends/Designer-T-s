          {% if section.settings.heading != blank %}
            <h2 class="heading font-heading  heading-standard heading-style break-words full_shadow mb-5">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.text != blank %}
            <p class="text">{{ section.settings.text }}</p>
          {% endif %}
