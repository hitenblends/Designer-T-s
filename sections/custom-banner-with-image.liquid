<div class="max-w-site py-5 mx-auto main-custom-banner">
<div class="custom-banner-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.font_color }};">
  <div class="custom-banner-container">
    <div class="custom-banner-text" >
      <h2 {% if section.settings.maxwidth %}style="max-width: {{ section.settings.maxwidth }}px;"{% endif %}>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>
    <div class="custom-banner-image">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | img_url: 'medium' }}" alt="Banner Image">
      {% endif %}
    </div>
  </div>
</div>
</div>


{% schema %}
{
  "name": "Custom Banner with image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Since 1985, we’ve been exceeding expectations every time."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "maxwidth",
      "min": 450,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Font size",
      "default": 900
    }
  ],
  "presets": [
    {
      "name": "Custom Banner with image"
    }
  ]
}
{% endschema %}
