
<div class="timeline-container">
  <div class="px-section relative z-10 max-w-site mx-auto"> 
  {% if section.settings.heading %}
  <h2 class="font-heading timeline-heading  heading-standard heading-style full_shadow ">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="timeline-bar">
    <div class="progress-track">
      <div class="progress-fill"></div>
    </div>

    {% for block in section.blocks %}
      <div class="timeline-point {% if forloop.first %}active{% endif %}" data-year="{{ block.settings.year }}">{{ block.settings.year }}</div>
    {% endfor %}
  </div>

  <div class="timeline-cards-wrapper">
  <div class="timeline-cards">
    {% for block in section.blocks %}
      <div class="timeline-card {% if forloop.first %}active{% endif %}" data-year="{{ block.settings.year }}">
        <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.year }} Image">
        <div class="year">{{ block.settings.year }}</div>
        <div class="desc">{{ block.settings.desc }}</div>
      </div>
    {% endfor %}
  </div>
  </div>
</div>
</div>

{% schema %}
  {
    "name": "Timeline",
    "settings": [
      {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
    ],
  "blocks": [
    {
      "type": "event",
      "name": "Timeline Event",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
      
        {
          "type": "richtext",
          "id": "desc",
          "label": "Description"
        }
      ]
    }
  ],
    "presets": [
		{
			"name": "Timeline"
        }
    ]
  }
{% endschema %}