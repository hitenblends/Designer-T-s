{% if section.blocks.size > 0 %}
  <div class="image-with-overlay">
    <div class="full-width">
      <div class="multiple-block-overlay">
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            <div class="main-block-overlay block-index-{{ forloop.length  }} image-overlay--{{ block.id }}">
              {% style %}
              .image-overlay--{{ block.id }} {
                opacity: {{ block.settings.image_overlay }};
              }
              .image-overlay--{{ block.id }} .image-overlay:after{
                 content:"";
                 background: rgb(0,0,0);
                  position: absolute;
                  left: 0;
                  top: 0;
                  width: 100%;
                  height: 100%;
                 background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 100%);
                 opacity: {{ block.settings.image_overlay }};
              }
            {% endstyle %}
              {% if block.settings.image != blank %}
                <div class="image-overlay">
                  <img src="{{ block.settings.image | image_url: width: 1920 }}">
                </div>
              {% endif %}
              {% if  block.settings.button != blank or block.settings.heading != blank %}
                <div class="image-content">
                  {% if block.settings.heading != blank %}
                    <h2 class="heading font-heading  heading-standard mb-6">{{ block.settings.heading }}</h2>
                  {% endif %}
                  {% if  block.settings.link != blank and  block.settings.button != blank %}
                    <a class="button inline-block push-btn" href="{{ block.settings.link }}"><span class="push-btn-surface">{{ block.settings.button }}</span></a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
  {
    "name": "Image with overlay",
    "max_blocks": 3,
    "settings": [],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "range",
            "id": "image_overlay",
            "max": 100,
            "min": 0,
            "step": 5,
            "unit": "%",
            "default": 10,
            "label": "Image overlay"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "text",
            "id": "button",
            "label": "Button"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Image with overlay"
      }
    ]
  }
{% endschema %}